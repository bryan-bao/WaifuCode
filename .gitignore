# ── 依赖和构建产物 ───────────────────────────────────────────────
node_modules/
dist/
.cache/

# ── 隐私数据：这些是「你和她之间的事」，不进仓库 ─────────────────
# 会话流水、聊天记录、心情存档、每个项目的小抄、终端参数文件
sessions/
# 个人配置（人设、模型选择、皮肤、路径）
config.json
# 探 codex 行为时用的临时 CODEX_HOME（tools 里那些探针会造，2MB 起步）
.tmp-codexhome/

# 截图（截给她看的图，全是你屏幕上的东西）
shots/
# 手机传上来的图和文件，属于用户数据
inbox/

# 运行日志
*.log

# ── 用户自己的音乐（版权 + 隐私，项目只播放不分发） ───────────────
music/

# ── 本地实验残留 ─────────────────────────────────────────────────
.testproj/
.waifu-probe/
workPosture
换装实测/
拟人化增强-决策清单.html
四套配色对比.png
效果-*.png
花纹-AI.png
# expression-sheet 默认落在根目录的产物（要收藏的自己挪进 docs/img/）
expressions-*.png
vendor/pylibs/__pycache__/
vendor/pylibs/**/__pycache__/

# 局域网更新：分发库和下载缓存都是每台机器自己的（里面是上百 MB 的安装包）
updates/
update-download/

# 打包状态（上次打到哪个提交）和生成的更新说明 —— 都是打包机自己的
.pack-state.json
release-notes.json

# 出门模式运行时下的 cloudflared（50 多 MB，每台机器自己下）
bin/
